# ==============================================================================
# Vidi Web - Environment Variables Template
# Copy this file to `.env.local` for local development.
# Configure these variables in your deployment platform (e.g., Vercel, Railway, Docker).
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Your Supabase project URL (Found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Publishable / Anon API key (Found in Project Settings > API)
# Safe to expose to the client browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"

# ------------------------------------------------------------------------------
# Upstash Redis Configuration (for TMDB Response Caching)
# ------------------------------------------------------------------------------
# Your Upstash Redis REST URL (Found in Upstash Console > Database Details > REST API)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"

# Your Upstash Redis REST Token (Found in Upstash Console > Database Details > REST API)
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# ------------------------------------------------------------------------------
# TMDB (The Movie Database) API Configuration
# ------------------------------------------------------------------------------
# TMDB API Read Access Token (v4 auth Bearer token)
# Obtain from: https://www.themoviedb.org/settings/api
TMDB_API_KEY="your-tmdb-api-read-access-token"
